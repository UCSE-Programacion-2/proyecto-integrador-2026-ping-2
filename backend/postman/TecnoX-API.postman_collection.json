					"name": "Register - 201 crea usuario",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Email único en cada corrida para no chocar con usuarios existentes",
									"pm.collectionVariables.set('userEmail', `postman.${Date.now()}@tecnox.com`);",
									"if (!pm.collectionVariables.get('userPassword')) pm.collectionVariables.set('userPassword', 'claveSegura123');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201', () => pm.response.to.have.status(201));",
									"pm.test('Responde con un mensaje', () => pm.expect(pm.response.json()).to.have.property('message'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
				},
